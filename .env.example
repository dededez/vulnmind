# VulnMind 本地配置示例。复制为 .env 后填写；不要把 .env 提交到 Git。
# 数据库需要 PostgreSQL 17 + pgvector，迁移头为 0018_workbench_jobs。
VULNMIND_DATABASE_URL=postgresql+psycopg://vulnmind:CHANGE_ME@127.0.0.1:5432/vulnmind

# 报告与证据目录（本机绝对路径）
VULNMIND_REPORT_ROOT=./.devtools/runtime/report
VULNMIND_EVIDENCE_ROOT=./.devtools/runtime/evidence

# 本机审批 HMAC 密钥（至少 32 字符，随机生成，不要提交）
VULNMIND_APPROVAL_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM

# 报告签名密钥（与上面的密钥互斥，二选一；至少 32 字符）
VULNMIND_REPORT_SIGNING_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM

# WSL 发行版名称；HTTP 隔离出口与外部工具在独立命名空间中执行
VULNMIND_HTTP_BROKER_DISTRO=VulnMindLab

# 已开放的独立 HTTP 入口（JSON 数组）
VULNMIND_ENABLED_HTTP_COMMANDS=["fetch","crawl","validate-run"]

# 真实模型规划与独立复核（可选）；不配置时使用规则模式
# DEEPSEEK_API_KEY=CHANGE_ME
